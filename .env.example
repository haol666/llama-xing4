# ==============================================================================
# .env.example — 复制为 .env 并按需修改
# ==============================================================================

# ghcr.io 镜像路径的 owner（镜像发布在 haol666 账号下）
IMAGE_OWNER=haol666

# 模型文件名（放在 ./models/ 目录下）
TARGET_MODEL=Xing4.0-29B-A4B-1Q3M.gguf

# MTP 投机解码深度
SPEC_N_MAX=4

# 上下文大小（模型原生支持 256K，按显存/内存余量调小）
CTX_SIZE=32768

# GPU 层数（99=全部放 GPU）
NGL=99
